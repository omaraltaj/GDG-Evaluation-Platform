# The HTTP service (app.server) only runs with BACKEND_MODE=real. mock is for the terminal chat and evals.
BACKEND_MODE=mock
BACKEND_URL=http://localhost:3001
# Must match CHATBOT_INTERNAL_KEY in 02-Backend/.env.
CHATBOT_INTERNAL_KEY=

GEMINI_API_KEY=
# Must be a model your key can call. gemini-2.5-flash is no longer offered to new keys.
# The service checks the key and model at startup and logs a clear error if either is rejected.
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated models tried when the main one is busy, rate-limited or retired.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# Per-request limit in milliseconds; a slow model fails fast and the next one is tried.
GEMINI_TIMEOUT_MS=12000
# Latency settings. Thinking is the slowest part of a call; factual lookups need almost none.
# minimal | low | medium | high, or empty for the model's default.
GEMINI_THINKING_LEVEL=minimal
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TEMPERATURE=0.2
# Full passes over the model list before giving up (the fallback models already retry).
LLM_RETRIES=1

# Safety limit: how many tool calls the model may chain for one question.
MAX_TOOL_ROUNDS=6
# Optional: pin "today" (useful for repeatable tests).
# MOCK_TODAY=2026-10-23
