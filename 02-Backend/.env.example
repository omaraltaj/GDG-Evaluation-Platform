NODE_ENV=development
PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gdg_evaluation
DB_USER=postgres
DB_PASSWORD=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_INVITATION_REDIRECT_URL=
# Allowed difference from Clerk's clock. Defaults: 60000 outside production, 5000 in production.
# CLERK_CLOCK_SKEW_MS=60000
# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Private Python chatbot service (03-AI). Use the same CHATBOT_INTERNAL_KEY in its .env.
CHATBOT_URL=http://127.0.0.1:8000
CHATBOT_INTERNAL_KEY=
CHATBOT_TIMEOUT_MS=60000
# Transactional email for registration decisions (approve / reject). Leave SMTP_HOST empty to
# disable sending; decisions still work and the request records notification_status=skipped.
# Port 465 uses implicit TLS; 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
